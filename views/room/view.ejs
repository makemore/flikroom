<script type="text/x-handlebars-template" id="tmpl-search-box">
    <input type="text" class="absolute" placeholder="search for video" style="left:${left}px; top:${top}px;"/>
</script>


<script type="text/x-handlebars-template" id="tmpl-search-node">
    "<div class='small-circle' style="left:${left}px; top:${top}px;"></div>"
</script>

<script type="text/x-handlebars-template" id="tmpl-result-node-youtube">
    <div class='node-youtube' style="left:${left}px; top:${top}px;"><img src="${image}"/></div>
</script>

<script id="searchCallback" type="text/javascript" src="">
</script>


<div id="canvasContainer">
    <div id="canvas">
        <div class="node"></div>
    </div>

    <div id="chatContainer" ng-controller="ChatCtrl">

        <div id="chats">
            <li><%= room.name%></li>
            <ul id="chatList">
                <li ng-repeat="chat in chats">
                    {{chat.user.username }} - {{chat.message}}
                </li>
            </ul>
        </div>
        <div class="chat-input-div">
            <input type="text" placeholder="say something!" id="chat-input" ng-enter="submitChat(event)"/>
        </div>
    </div>
</div>

<script>
    var roomId = <%= room.id %>;
    var userId = <%= userId %>;
</script>