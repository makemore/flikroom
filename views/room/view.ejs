<script type="text/x-handlebars-template" id="tmpl-search-box">
    <div class="absolute" style="left:${left}px; top:${top}px;">
        <div class="filter-container">
            <div class="filter-icon filter-option-video" data-type="video"></div>
            <div class="filter-dropdown-icon"></div>
        </div>
        <input type="text" style="display:inline-block" class="uberbox" placeholder="search..."/>
        <div class="close-omni"></div>
        <div class="filter-dropdown-handle">
            <div class="filter-dropdown">
                <div class="filter-option filter-option-everything" data-type="everything">Everything</div>
                <div class="filter-option filter-option-image" data-type="images">Images</div>
                <div class="filter-option filter-option-video" data-type="video">Videos</div>
                <div class="filter-option filter-option-sound" data-type="sound">Sounds</div>
                <div class="filter-option filter-option-page" data-type="page">Web Pages</div>
            </div>
        </div>
    </div>
</script>

<script type="text/x-handlebars-template" id="tmpl-search-node">
    <div class='search-result-handle' id="${id}" style="left:${left}px; top:${top}px;">${numberOfResults}</div>
</script>

<script type="text/x-handlebars-template" id="tmpl-node-path">
    <div class='node-path-container' style="left:${left}px; top:${top}px;width:${width}px;height:${height}px;">
        <svg xmlns="http://www.w3.org/2000/svg"
             xmlns:xlink="http://www.w3.org/1999/xlink">
            <path d="M${sX},${sY}
                    C${c1X},${c1Y}
                    ${c2X},${c2Y}
                    ${eX},${eY}"
                  style="stroke:#000; stroke-width:3px; fill:none;"/>
        </svg>
    </div>
</script>

<script type="text/x-handlebars-template" id="tmpl-result-node-youtube">
    <div class='node-youtube-search-result search-result' style="left:${left}px; top:${top}px; background-image:url(${image});" data-id="${id}">
        <div>${title}</div>
    </div>
</script>

<script type="text/x-handlebars-template" id="tmpl-result-node-bing">
    <div class='node-bing-search-result search-result' style="left:${left}px; top:${top}px;" data-id="${id}">${title}</div>
</script>

<script type="text/x-handlebars-template" id="tmpl-web-page">
    <div class="node-body">${description}</div>
</script>

<script type="text/x-handlebars-template" id="tmpl-youtube-player">
    <div class="node-body" id='youtube-player${rndNum}'></div>
</script>

<script type="text/x-handlebars-template" id="tmpl-node-base">
    <div class='{{className}}' style="left:{{left}}px; top:{{top}}px;">
        <div class="node-menu">{{title}}<div class="node-close">X</div></div>
        {{{body}}}
        <div class="node-footer">
            <div class="node-handle handle-input"></div>
            <div class="node-handle handle-output"></div>
        </div>
    </div>
</script>


<div id="canvasContainer">
    <div id="canvas">
        <div class="node"></div>
    </div>

    <div id="chatContainer" ng-controller="ChatCtrl">

        <div id="chats">
            <li><%= room.name%></li>
            <ul id="chatList">
                <li ng-repeat="chat in chats">
                    {{chat.user.username }} - {{chat.message}}
                </li>
            </ul>
        </div>
        <div class="chat-input-div">
            <input type="text" placeholder="say something!" id="chat-input" ng-enter="submitChat(event)"/>
        </div>
    </div>
</div>

<script>
    var roomId = <%= room.id %>;
    var userId = <%= userId %>;
</script>

<script type="text/javascript">

    var FizzyText = function() {
        this.message = 'dat.gui';
        this.speed = 0.8;
        this.displayOutline = false;
        this.explode = function() {

        };
        // Define render logic ...
    };

    window.onload = function() {
        var text = new FizzyText();
        var gui = new dat.GUI();
        gui.add(text, 'message');
        gui.add(text, 'speed', -5, 5);
        gui.add(text, 'displayOutline');
        gui.add(text, 'explode');
    };

</script>